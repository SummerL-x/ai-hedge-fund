# ========== OpenAI API 配置 ==========
# 用于运行 LLM (gpt-4o, gpt-4o-mini 等)
OPENAI_API_KEY=your-openai-api-key

# ========== 其他 LLM 服务配置 ==========
# Groq LLM
GROQ_API_KEY=your-groq-api-key

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ========== 掘金量化 (Gquant) 配置 ==========
# 从 https://www.myquant.cn/ 的账户设置中获取
# 您的掘金量化账户 ID
GQUANT_ACCOUNT_ID=YOUR_ACCOUNT_ID

# 您的掘金量化 API Token
GQUANT_API_TOKEN=YOUR_API_TOKEN

# 掘金量化 API 地址（通常不需要修改）
GQUANT_API_URL=https://api.myquant.cn

# ========== 金融数据 API 配置 ==========
# 用于获取股票数据的 API 密钥
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key

# ========== 开发配置 ==========
DEBUG=False
ENVIRONMENT=development
